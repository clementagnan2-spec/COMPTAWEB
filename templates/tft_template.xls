   <Column ss:Width="210"/>
   <Column ss:Width="90" ss:Span="1"/>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">TABLEAU DE FLUX DE TRESORERIE</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">1</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Edition du : 01/01/2024 au 31/12/2024                                                            Avec brouillard                    Hors simulation</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"/>
    <Cell ss:StyleID="s62"/>
    <Cell ss:StyleID="s62"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"/>
    <Cell ss:StyleID="s63"/>
    <Cell ss:StyleID="s62"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s64"><Data ss:Type="String">RUBRIQUE</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">N</Data></Cell>
    <Cell ss:StyleID="s66"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s67"><Data ss:Type="String">A-&quot;Trésorerie nette au 1er janvier N-1</Data></Cell>
    <Cell ss:StyleID="s68"><Data ss:Type="String">=CtaCptSoldeNm1(&quot;50*&quot;,&quot;58*&quot;)</Data></Cell>
    <Cell ss:StyleID="s69"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s70"/>
    <Cell ss:StyleID="s71"/>
    <Cell ss:StyleID="s69"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s72"><Data ss:Type="String">DETERMINATION DE LA CAPACITE D'AUTOFINANCEMENT</Data></Cell>
    <Cell ss:StyleID="s73"/>
    <Cell ss:StyleID="s69"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s74"><Data ss:Type="String">EBE</Data></Cell>
    <Cell ss:StyleID="s73"><Data ss:Type="String">=[011.EtLoc]=-CtaCptSolde(&quot;701*&quot;)+CtaCptSolde(&quot;601*&quot;)-CtaCptSolde(&quot;702*&quot;,&quot;704*&quot;)-CtaCptSolde(&quot;705*&quot;,&quot;706*&quot;)-CtaCptSolde(&quot;707&quot;)-CtaCptSolde(&quot;713*&quot;)-CtaCptSolde(&quot;72*&quot;,&quot;73*&quot;)-CtaCptSolde(&quot;71*&quot;)-CtaCptSolde(&quot;74*&quot;,&quot;76*&quot;)-CtaCptSolde(&quot;781*&quot;)-CtaCptSolde(&quot;601*&quot;,&quot;602*&quot;)-CtaCptSolde(&quot;6032*&quot;)-CtaCptSolde(&quot;604*&quot;,&quot;609*&quot;)-CtaCptSolde(&quot;6033*&quot;,&quot;6038*&quot;)-CtaCptSolde(&quot;61*&quot;)-CtaCptSolde(&quot;62*&quot;,&quot;63*&quot;)-CtaCptSolde(&quot;64*&quot;)-CtaCptSolde(&quot;65*&quot;)-CtaCptSolde(&quot;66*&quot;)</Data></Cell>
    <Cell ss:StyleID="s69"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">- VALEURS COMPTABLE DE CESSION COURANTES D'IMM 654</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">=[331.EtLoc]=-CtaCptSolde(&quot;654*&quot;)</Data></Cell>
    <Cell ss:StyleID="s69"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">+PRODUITS DE CESSION COURANTES D'IMM 754</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">=[311.EtLoc]=CtaCptSolde(&quot;754*&quot;)</Data></Cell>
    <Cell ss:StyleID="s69"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">+TRANSFERT DE CHARGES D'EXPLOITATION</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">=[311.EtLoc]=CtaCptSolde(&quot;781*&quot;)</Data></Cell>
    <Cell ss:StyleID="s69"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s72"><Data ss:Type="String">CAPACITE D'AUTOFINANCEMENT D'EXPLOITATION</Data></Cell>
    <Cell ss:StyleID="s73"><Data ss:Type="String">=[312.EtLoc]=[311.EtLoc]+[331.EtLoc]+[011.EtLoc]</Data></Cell>
    <Cell ss:StyleID="s69"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">+REVENUS FINANCIERS</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">=[101.EtLoc]=-CtaCptSolde(&quot;77*&quot;)</Data></Cell>
    <Cell ss:StyleID="s77"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">+GAINS DE CHANGE</Data></Cell>
    <Cell ss:StyleID="s76"/>
    <Cell ss:StyleID="s77"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">+TRANSFERTS DE CHARGES FINANCIERES</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">=[291.EtLoc]=CtaCptSolde(&quot;787*&quot;)</Data></Cell>
    <Cell ss:StyleID="s77"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">+PRODUITS HAO</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">=[291.EtLoc]=CtaCptSolde(&quot;84*&quot;)</Data></Cell>
    <Cell ss:StyleID="s77"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">-FRAIS FINANCIERS</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">=[301.EtLoc]=-CtaCptSolde(&quot;67*&quot;)</Data></Cell>
    <Cell ss:StyleID="s77"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">-PERTES DE CHANGE</Data></Cell>
    <Cell ss:StyleID="s76"/>
    <Cell ss:StyleID="s77"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">-PARTICIPATION</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">=[281.EtLoc]=-CtaCptSolde(&quot;87*&quot;)</Data></Cell>
    <Cell ss:StyleID="s77"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">-IMPOTS SUR LES RESULTATS</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">=[291.EtLoc]=-CtaCptSolde(&quot;89*&quot;)</Data></Cell>
    <Cell ss:StyleID="s77"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s72"><Data ss:Type="String">CAPACITE D'AUTOFINANCEMENT GLOBAL (CAFG)</Data></Cell>
    <Cell ss:StyleID="s73"><Data ss:Type="String">=[332.EtLoc]=[312.EtLoc]+[101.EtLoc]+[301.EtLoc]</Data></Cell>
    <Cell ss:StyleID="s69"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">- Variation d'actif circulant HAO (1)</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">=-CtaCptSoldeDébit(&quot;46*&quot;,&quot;49*&quot;)+CtaCptSoldeDébitNm1(&quot;46*&quot;,&quot;49*&quot;)</Data></Cell>
    <Cell ss:StyleID="s77"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">- Variation des stocks</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String" x:Ticked="1">=-CtaCptSoldeDébit(&quot;3*&quot;)+CtaCptSoldeDébitNm1(&quot;3*&quot;)</Data></Cell>
    <Cell ss:StyleID="s77"/>
   </Row>
   <Row>
    <Cell ss:StyleID="s75"><Data ss:Type="String">-  Variation des créances</Data></Cell>
